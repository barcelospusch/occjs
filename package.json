{
  "name": "@occjs/occjs",
  "version": "0.1.2",
  "description": "JavaScript library for querying stellar occultation predictions from the LIneA Solar System API.",
  "keywords": [
    "astronomy",
    "occultation",
    "stellar-occultations",
    "asteroids",
    "linea",
    "lineassp",
    "predictions"
  ],
  "homepage": "https://github.com/barcelospusch/occjs#readme",
  "bugs": {
    "url": "https://github.com/barcelospusch/occjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barcelospusch/occjs.git"
  },
  "license": "MIT",
  "author": "dimitri.pusch",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js"
    }
  },
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "directories": {
    "example": "examples",
    "test": "test"
  },
  "files": [
    "src",
    "index.d.ts"
  ],
  "scripts": {
    "test": "node --test",
    "start": "node examples/server.js",
    "example": "node examples/server.js"
  },
  "dependencies": {
    "aladin-lite": "^3.9.2-beta",
    "openmeteo": "^1.2.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "@occjs:registry": "https://registry.npmjs.org/"
  }
}
