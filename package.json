{
  "name": "@dimitri.pusch/occjs",
  "version": "0.3.1",
  "description": "JavaScript library for querying stellar occultation predictions from the LIneA Solar System API.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "index.d.ts"
  ],
  "scripts": {
    "test": "node --test",
    "start": "node examples/server.js",
    "example": "node examples/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "astronomy",
    "occultation",
    "stellar-occultations",
    "asteroids",
    "linea",
    "lineassp",
    "predictions"
  ],
  "license": "MIT",
  "dependencies": {
    "openmeteo": "^1.2.3"
  }
}
